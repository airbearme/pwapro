{
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "middleware.ts"
  ],
  "extensions": [".ts", ".tsx", ".js", ".jsx"],
  "ignoreUnresolved": [],
  "ignoreUnimported": [],
  "ignoreUnused": [],
  "moduleDirectory": ["node_modules", "."],
  "failOnUnused": false,
  "failOnUnimported": false
}
